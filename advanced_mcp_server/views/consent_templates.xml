<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Self-contained layout using web.layout + web.assets_frontend.
         Do NOT use web.login_layout / web.frontend_layout: website module
         extends that chain with a website-only context that 500s when
         website is installed. web.layout is safe with or without website. -->
    <template id="adv_oauth_layout" name="Adv MCP OAuth Layout">
        <t t-call="web.layout">
            <t t-set="title">Authorize access</t>
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
            <t t-set="body_classname" t-value="'bg-100'" />
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <t t-call-assets="web.assets_frontend" t-js="false" />
            </t>
            <div
                class="min-vh-100"
                style="background: linear-gradient(135deg, #f0eff6 0%, #e7e6f0 55%, #f2f1f7 100%);"
            >
                <div class="container py-5">
                    <div
                        class="card border-0 mx-auto bg-100 o_database_list"
                        style="max-width: 21.43em;"
                    >
                        <div class="card-body">
                            <div class="text-center pb-3 border-bottom mb-3">
                                <img
                                    src="/web/binary/company_logo"
                                    alt="Logo"
                                    style="max-height:120px; max-width: 100%; width:auto"
                                />
                            </div>
                            <t t-out="0" />
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="adv_oauth_error" name="Adv MCP OAuth Error">
        <t t-call="advanced_mcp_server.adv_oauth_layout">
            <h1 class="h5 mb-3 text-center">Authorization request rejected</h1>
            <p class="text-muted text-center mb-0">
                <t t-out="error_description" />
            </p>
        </t>
    </template>
</odoo>
