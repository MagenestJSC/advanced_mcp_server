<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="group_adv_user" model="res.groups">
            <field name="name">Adv MCP User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>
        <record id="group_adv_admin" model="res.groups">
            <field name="name">Adv MCP Administrator</field>
            <field name="implied_ids" eval="[(4, ref('advanced_mcp_server.group_adv_user'))]" />
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('advanced_mcp_server.group_adv_admin'))]" />
        </record>

        <record id="rule_adv_module_access_user" model="ir.rule">
            <field name="name">Adv Module Access: user read</field>
            <field name="model_id" ref="model_adv_module_access" />
            <field name="groups" eval="[(4, ref('advanced_mcp_server.group_adv_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
